  /*
   * ---------------------------------------------------------
   * PRODUCT HELPERS
   * ---------------------------------------------------------
   */

  function getHandleFromUrl(url) {
    if (!url) {
      return "";
    }

    const value =
      String(url).trim();

    const match =
      value.match(
        /\/products\/([^?#/]+)/i
      );

    if (!match) {
      return "";
    }

    try {
      return decodeURIComponent(
        match[1]
      );
    } catch (err) {
      return match[1];
    }
  }

  function cleanHandle(handle) {
    if (!handle) {
      return "";
    }

    let value =
      String(handle).trim();

    value =
      value.replace(
        /^.*\/products\//i,
        ""
      );

    value =
      value
        .split("?")[0]
        .split("#")[0]
        .replace(/^\/+/, "")
        .replace(/\/+$/, "");

    return value;
  }

  function normalizeProduct(item) {
    if (!item) {
      return null;
    }

    if (typeof item === "string") {
      const handle =
        cleanHandle(item);

      if (!handle) {
        return null;
      }

      return {
        handle: handle,
        title: "",
        url: "/products/" + handle
      };
    }

    if (
      typeof item !== "object"
    ) {
      return null;
    }

    const nested =
      item.product ||
      item.product_data ||
      item.productData ||
      null;

    const source =
      nested &&
      typeof nested === "object"
        ? {
            ...nested,
            ...item
          }
        : item;

    const url =
      source.url ||
      source.product_url ||
      source.productUrl ||
      source.link ||
      "";

    let handle =
      source.handle ||
      source.product_handle ||
      source.productHandle ||
      source.slug ||
      "";

    if (!handle && url) {
      handle =
        getHandleFromUrl(url);
    }

    handle =
      cleanHandle(handle);

    if (!handle) {
      return null;
    }

    return {
      handle: handle,

      title:
        source.title ||
        source.name ||
        source.product_title ||
        "",

      url:
        url ||
        "/products/" +
          handle,

      description:
        source.description ||
        source.product_description ||
        "",

      price:
        source.price ||
        "",

      compare_at_price:
        source.compare_at_price ||
        source.compareAtPrice ||
        "",

      image:
        source.image ||
        source.image_url ||
        source.imageUrl ||
        source.featured_image ||
        "",

      type:
        source.type ||
        source.product_type ||
        source.productType ||
        "",

      variant_id:
        numericVariantId(
          source.variant_id ||
            source.variantId ||
            ""
        ),

      match_percent:
        Number(source.match_percent) || 0,

      match_terms:
        Array.isArray(source.match_terms)
          ? source.match_terms
          : [],

      inspired_by:
        source.inspired_by ||
        inspiredByName(
          source.description ||
            source.product_description ||
            ""
        ),

      cn1_original:
        source.cn1_original === true
    };
  }

  function genderLabel(type) {
    const value = String(type || "").toLowerCase();

    if (!value) {
      return "";
    }

    if (value.indexOf("unisex") !== -1) {
      return "Unisex";
    }

    if (
      value.indexOf("women") !== -1 ||
      value.indexOf("woman") !== -1
    ) {
      return "For Women";
    }

    if (
      value.indexOf("men") !== -1 ||
      value.indexOf("man") !== -1
    ) {
      return "For Men";
    }

    return "";
  }

  function inspiredByName(text) {
    const plain =
      String(text || "")
        .replace(/<[^>]+>/g, " ")
        .replace(/\s+/g, " ");

    const match =
      plain.match(
        /inspired by\s+([^.]{2,90})/i
      );

    if (!match) {
      return "";
    }

    const name =
      match[1]
        .split(/[,;]/)[0]
        .replace(/'s\b/gi, "")
        .replace(/\s+/g, " ")
        .trim();

    if (!name) {
      return "";
    }

    return name
      .toLowerCase()
      .replace(
        /\b[a-z]/g,
        function (letter) {
          return letter.toUpperCase();
        }
      );
  }

  function moneyNumber(value) {
    const amount = Number(
      String(value || "").replace(/[^0-9.]/g, "")
    );

    return Number.isFinite(amount) ? amount : 0;
  }

  function collectProductItems(
    source,
    output,
    seen
  ) {
    if (!source) {
      return;
    }

    if (Array.isArray(source)) {
      source.forEach(function (item) {
        collectProductItems(
          item,
          output,
          seen
        );
      });

      return;
    }

    const normalized =
      normalizeProduct(source);

    if (
      normalized &&
      normalized.handle
    ) {
      if (
        !seen.has(
          normalized.handle
        )
      ) {
        seen.add(
          normalized.handle
        );

        output.push(normalized);
      }

      return;
    }

    if (
      typeof source !== "object"
    ) {
      return;
    }

    const possibleKeys = [
      "products",
      "recommendations",
      "recommended_products",
      "recommendedProducts",
      "matches",
      "results",
      "items",
      "product",
      "recommendation",
      "recommended_product",
      "data",
      "response",
      "result"
    ];

    possibleKeys.forEach(function (key) {
      if (source[key]) {
        collectProductItems(
          source[key],
          output,
          seen
        );
      }
    });
  }

  function extractHandlesFromText(text) {
    if (!text) {
      return [];
    }

    const matches =
      String(text).match(
        /(?:https?:\/\/[^/\s]+)?\/products\/([a-zA-Z0-9._~-]+)/gi
      ) || [];

    const handles = [];

    matches.forEach(function (match) {
      const handle =
        getHandleFromUrl(match);

      if (
        handle &&
        handles.indexOf(handle) === -1
      ) {
        handles.push(handle);
      }
    });

    return handles;
  }

  /*
   * ---------------------------------------------------------
   * SHOPIFY PRODUCT SEARCH
   * ---------------------------------------------------------
   */

  function searchShopifyProducts(query) {
    const searchText =
      stripHtml(query)
        .replace(
          /https?:\/\/\S+/gi,
          ""
        )
        .trim();

    if (!searchText) {
      return Promise.resolve([]);
    }

    const url =
      "/search/suggest.json" +
      "?q=" +
      encodeURIComponent(
        searchText.slice(0, 250)
      ) +
      "&resources[type]=product" +
      "&resources[limit]=" +
      MAX_DISPLAY_PRODUCTS +
      "&resources[options][unavailable_products]=show";

    return fetch(url, {
      method: "GET",
      headers: {
        Accept:
          "application/json"
      },
      credentials:
        "same-origin"
    })
      .then(function (response) {
        if (!response.ok) {
          throw new Error(
            "shopify_search_failed"
          );
        }

        return response.json();
      })
      .then(function (data) {
        const raw =
          data &&
          data.resources &&
          data.resources.results &&
          data.resources.results.products
            ? data.resources.results.products
            : [];

        const products = [];
        const seen = new Set();

        raw.forEach(function (item) {
          const normalized =
            normalizeProduct(item);

          if (
            normalized &&
            normalized.handle &&
            !seen.has(
              normalized.handle
            )
          ) {
            seen.add(
              normalized.handle
            );

            products.push(
              normalized
            );
          }
        });

        return products.slice(
          0,
          MAX_DISPLAY_PRODUCTS
        );
      })
      .catch(function () {
        return [];
      });
  }

  /*
   * ---------------------------------------------------------
   * CATALOG FALLBACK
   * ---------------------------------------------------------
   *
   * This is the final safety net.
   *
   * Even if AI returns no product object, no product handle,
   * and Shopify search cannot find the user's phrase, we
   * still load products from the Shopify catalog so the
   * product-card area does not disappear.
   */
  function loadCatalogFallbackProducts() {
    const url =
      "/products.json?limit=" +
      MAX_DISPLAY_PRODUCTS;

    return fetch(url, {
      method: "GET",
      headers: {
        Accept:
          "application/json"
      },
      credentials:
        "same-origin"
    })
      .then(function (response) {
        if (!response.ok) {
          throw new Error(
            "catalog_fallback_failed"
          );
        }

        return response.json();
      })
      .then(function (data) {
        const raw =
          data &&
          Array.isArray(data.products)
            ? data.products
            : [];

        const products = [];
        const seen = new Set();

        raw.forEach(function (item) {
          const normalized =
            normalizeProduct({
              handle:
                item.handle,
              title:
                item.title,
              description:
                item.body_html,
              image:
                item.images &&
                item.images[0]
                  ? item.images[0].src
                  : "",
              url:
                "/products/" +
                item.handle
            });

          if (
            normalized &&
            normalized.handle &&
            !seen.has(
              normalized.handle
            )
          ) {
            seen.add(
              normalized.handle
            );

            products.push(
              normalized
            );
          }
        });

        return products.slice(
          0,
          MAX_DISPLAY_PRODUCTS
        );
      })
      .catch(function () {
        return [];
      });
  }

  /*
   * ---------------------------------------------------------
   * EXTRACT PRODUCTS FROM AI RESPONSE
   * ---------------------------------------------------------
   */

  function extractProducts(data) {
    const products = [];
    const seen = new Set();

    if (!data) {
      return products;
    }

    [
      data.products,
      data.recommendations,
      data.recommended_products,
      data.recommendedProducts,
      data.matches,
      data.results,
      data.items,
      data.product,
      data.recommendation,
      data.recommended_product,
      data.data,
      data.response,
      data.result
    ].forEach(function (source) {
      collectProductItems(
        source,
        products,
        seen
      );
    });

    /*
     * Support old single-handle responses.
     */
    if (data.handle) {
      collectProductItems(
        {
          handle: data.handle,
          title: data.title || "",
          url: data.url || ""
        },
        products,
        seen
      );
    }

    /*
     * Product URLs inside AI reply.
     */
    const reply =
      typeof data.reply === "string"
        ? data.reply
        : "";

    extractHandlesFromText(
      reply
    ).forEach(function (handle) {
      collectProductItems(
        {
          handle: handle,
          url:
            "/products/" +
            handle
        },
        products,
        seen
      );
    });

    return products.slice(
      0,
      MAX_DISPLAY_PRODUCTS
    );
  }

  /*
   * ---------------------------------------------------------
   * SHOPIFY PRODUCT JSON
   * ---------------------------------------------------------
   */

  function firstVariantId(product) {
    const variants =
      product && product.variants;

    if (
      !variants ||
      !variants.length
    ) {
      return product && product.variant_id
        ? String(product.variant_id)
        : "";
    }

    const available = variants.find(function (variant) {
      return variant && variant.available;
    });

    const chosen = available || variants[0];

    return chosen && chosen.id
      ? String(chosen.id)
      : "";
  }

  function loadShopifyProduct(
    productData
  ) {
    const candidate =
      normalizeProduct(
        productData
      );

    if (!candidate) {
      return Promise.resolve(null);
    }

    const safeHandle =
      cleanHandle(
        candidate.handle
      );

    if (!safeHandle) {
      return Promise.resolve(null);
    }

    return fetch(
      "/products/" +
        encodeURIComponent(
          safeHandle
        ) +
        ".js",
      {
        headers: {
          Accept:
            "application/json"
        },
        credentials:
          "same-origin"
      }
    )
      .then(function (response) {
        if (!response.ok) {
          throw new Error(
            "product_not_found"
          );
        }

        return response.json();
      })
      .then(function (product) {
        return {
          handle: safeHandle,

          title:
            product.title ||
            candidate.title ||
            "Your fragrance match",

          description:
            stripHtml(
              product.description
            ).slice(0, 140),

          inspired_by:
            candidate.cn1_original
              ? "CN1 Original"
              : inspiredByName(
                  product.description ||
                    candidate.description ||
                    candidate.inspired_by ||
                    ""
                ),

          cn1_original:
            candidate.cn1_original === true,

          price:
            product.price
              ? formatMoney(
                  product.price
                )
              : candidate.price
                ? String(
                    candidate.price
                  )
                : "",

          compare_at_price:
            product.compare_at_price
              ? formatMoney(
                  product.compare_at_price
                )
              : candidate.compare_at_price || "",

          image:
            product.featured_image ||
            (
              product.images &&
              product.images[0]
            ) ||
            candidate.image ||
            "",

          url:
            product.url ||
            candidate.url ||
            "/products/" +
              safeHandle,

          type:
            product.type ||
            candidate.type ||
            "",

          variant_id:
            firstVariantId(product),

          match_percent:
            Number(candidate.match_percent) || 0,

          match_terms:
            Array.isArray(candidate.match_terms)
              ? candidate.match_terms
              : []
        };
      })
      .catch(function () {
        return {
          handle: safeHandle,

          title:
            candidate.title ||
            "Your fragrance match",

          description:
            stripHtml(
              candidate.description
            ).slice(0, 140),

          inspired_by:
            candidate.cn1_original
              ? "CN1 Original"
              : (
                  candidate.inspired_by ||
                  inspiredByName(
                    candidate.description || ""
                  )
                ),

          cn1_original:
            candidate.cn1_original === true,

          price:
            candidate.price || "",

          image:
            candidate.image || "",

          url:
            candidate.url ||
            "/products/" +
              safeHandle,

          type:
            candidate.type || "",

          variant_id:
            candidate.variant_id || "",

          match_percent:
            Number(candidate.match_percent) || 0,

          match_terms:
            Array.isArray(candidate.match_terms)
              ? candidate.match_terms
              : []
        };
      });
  }

  function hydrateProducts(products) {
    if (
      !products ||
      !products.length
    ) {
      return Promise.resolve([]);
    }

    return Promise.all(
      products
        .slice(
          0,
          MAX_DISPLAY_PRODUCTS
        )
        .map(function (product) {
          return loadShopifyProduct(
            product
          );
        })
    ).then(function (loaded) {
      const result = [];
      const seen = new Set();

      loaded.forEach(function (product) {
        if (
          !product ||
          !product.handle
        ) {
          return;
        }

        const handle =
          cleanHandle(
            product.handle
          );

        if (
          !handle ||
          seen.has(handle)
        ) {
          return;
        }

        seen.add(handle);

        result.push({
          ...product,
          handle: handle
        });
      });

      return result;
    });
  }

  function numericVariantId(value) {
    const match =
      String(value || "").match(
        /(\d+)\s*$/
      );

    return match ? match[1] : "";
  }

  const DNA_WORDS = [
    "fresh",
    "clean",
    "woody",
    "vanilla",
    "amber",
    "floral",
    "citrus",
    "musk",
    "oud",
    "sweet",
    "spicy",
    "warm",
    "green",
    "rose",
    "jasmine",
    "sandalwood",
    "cedarwood",
    "vetiver",
    "aquatic",
    "powdery",
    "leather"
  ];

  function prettyNameFromEmail(email) {
    const local =
      String(email || "")
        .split("@")[0] ||
      "Guest";

    const parts =
      local
        .split(/[._+\-]+/)
        .filter(Boolean);

    if (!parts.length) {
      return "Guest";
    }

    return parts
      .map(function (part) {
        return (
          part.charAt(0).toUpperCase() +
          part.slice(1).toLowerCase()
        );
      })
      .join(" ");
  }

  function initialsFrom(name) {
    const parts =
      String(name || "")
        .trim()
        .split(/\s+/)
        .filter(Boolean);

    if (!parts.length) {
      return "G";
    }

    if (parts.length === 1) {
      return parts[0]
        .slice(0, 2)
        .toUpperCase();
    }

    return (
      parts[0].charAt(0) +
      parts[1].charAt(0)
    ).toUpperCase();
  }

  function guestDisplayName() {
    if (
      shopCustomerName &&
      (
        !customerEmail ||
        customerEmail.toLowerCase() ===
          {{ customer.email | default: '' | json }}.toLowerCase()
      )
    ) {
      return shopCustomerName;
    }

    return prettyNameFromEmail(
      customerEmail
    );
  }

  function wordsPresent(text, words) {
    const value =
      String(text || "").toLowerCase();

    const found = [];

    words.forEach(function (word) {
      const pattern =
        new RegExp(
          "\\b" + word + "\\b",
          "i"
        );

      if (
        pattern.test(value) &&
        found.indexOf(word) === -1
      ) {
        found.push(word);
      }
    });

    return found;
  }

  function updateGuestPanel(query, matchCount) {
    const name =
      guestDisplayName();

    if (guestAvatar) {
      guestAvatar.textContent =
        initialsFrom(name);
    }

    if (guestName) {
      guestName.textContent = name;
    }

    if (guestEmail) {
      guestEmail.textContent =
        customerEmail || "";
    }

    if (
      guestLooking &&
      typeof query === "string"
    ) {
      guestLooking.textContent =
        query || "—";
      guestLooking.title = query || "";
    }

    if (
      guestMatches &&
      matchCount !== undefined &&
      matchCount !== null
    ) {
      guestMatches.textContent =
        String(matchCount);
    }
  }

  function appendWelcome(query) {
    const row =
      document.createElement("div");

    row.className =
      "chat-row bot";

    row.innerHTML =
      "<div class='bot-bubble welcome-bubble'>" +
      "<p class='welcome-copy'>" +
      "<strong>" +
      escapeHtml(guestDisplayName()) +
      "</strong>, you're in. Let's find something quietly luxurious. First note: “" +
      escapeHtml(query) +
      "”." +
      "</p>" +
      "</div>";

    chatThread.appendChild(row);
    scrollThread();
  }

  function matchCopy(product, query) {
    const fromApi =
      Number(product && product.match_percent);

    if (fromApi > 0) {
      const terms =
        Array.isArray(product.match_terms)
          ? product.match_terms
          : [];

      return {
        why: terms.slice(0, 3).join(", "),
        percent: fromApi
      };
    }

    const hay = [
      product.description || "",
      product.type || "",
      product.title || ""
    ]
      .join(" ")
      .toLowerCase();

    const hits =
      wordsPresent(query, DNA_WORDS)
        .filter(function (word) {
          return hay.indexOf(word) !== -1;
        });

    if (!hits.length) {
      return {
        why: "",
        percent: 0
      };
    }

    return {
      why: hits.slice(0, 3).join(", "),
      percent: Math.min(
        96,
        74 + hits.length * 7
      )
    };
  }

  function plainPrice(value) {
    const amount =
      moneyNumber(value);

    if (!amount) {
      return "";
    }

    return amount.toFixed(2);
  }

  /*
   * ---------------------------------------------------------
   * PRODUCT CARD HTML
   * ---------------------------------------------------------
   */

  function productCardHtml(
    product,
    cardIndex
  ) {
    if (
      !product ||
      !product.handle
    ) {
      return "";
    }

    const idxStyle =
      typeof cardIndex === "number"
        ? " style='--card-index:" +
          cardIndex +
          "'"
        : "";

    const image =
      withHttps(
        product.image
      );

    const priceAmount =
      moneyNumber(product.price);

    const compareAmount =
      moneyNumber(product.compare_at_price);

    const onSale =
      compareAmount > priceAmount &&
      priceAmount > 0;

    const matched =
      matchCopy(
        product,
        lastGuestQuery
      );

    const shownPrice =
      plainPrice(product.price)
        ? "$" + plainPrice(product.price)
        : (product.price || "");

    const audience =
      genderLabel(product.type);

    const inspired =
      product.inspired_by ||
      inspiredByName(
        product.description || ""
      );

    const isOriginal =
      product.cn1_original === true ||
      /cn1\s*originals?/i.test(
        String(inspired || "")
      );

    const imageHtml =
      "<div class='product-image-wrap'>" +
      (
        onSale
          ? "<span class='product-badge sale'>Sale</span>"
          : ""
      ) +
      (
        image
          ? (
              "<img " +
              "class='product-image' " +
              "src='" +
              escapeHtml(image) +
              "' " +
              "alt='" +
              escapeHtml(
                product.title ||
                  "Fragrance"
              ) +
              "' " +
              "loading='lazy'>"
            )
          : ""
      ) +
      "</div>";

    return (
      "<article class='product-card'" +
      idxStyle +
      ">" +

      imageHtml +

      "<div class='product-info'>" +

      (
        matched.percent
          ? (
              "<p class='product-match'>" +
              matched.percent +
              "% match</p>"
            )
          : ""
      ) +

      "<div class='product-head'>" +
      "<h3 class='product-title'>" +
      escapeHtml(
        product.title || ""
      ) +
      "</h3>" +
      "<div class='product-price-col'>" +
      (
        shownPrice
          ? (
              "<div class='product-price'>" +
              escapeHtml(shownPrice) +
              "</div>"
            )
          : ""
      ) +
      (
        onSale
          ? (
              "<div class='product-compare'>" +
              escapeHtml(
                "$" +
                  (
                    plainPrice(
                      product.compare_at_price
                    ) ||
                    ""
                  )
              ) +
              "</div>"
            )
          : ""
      ) +
      "</div>" +
      "</div>" +

      (
        audience
          ? (
              "<p class='product-audience'>" +
              escapeHtml(audience) +
              "</p>"
            )
          : "<p class='product-audience'></p>"
      ) +

      (
        isOriginal
          ? "<p class='product-inspired'>CN1 Original</p>"
          : (
              inspired
                ? (
                    "<p class='product-inspired'>Inspired by: " +
                    escapeHtml(inspired) +
                    "</p>"
                  )
                : "<p class='product-inspired'></p>"
            )
      ) +

      "<button " +
      "type='button' " +
      "class='product-link add-to-cart' " +
      "data-handle='" +
      escapeHtml(product.handle) +
      "' " +
      "data-variant-id='" +
      escapeHtml(
        product.variant_id || ""
      ) +
      "'>" +
      "Add to cart" +
      "</button>" +

      "</div>" +

      "</article>"
    );
  }

  let originalHandleRequest = null;

  function originalHandleMap() {
    if (originalHandleRequest) {
      return originalHandleRequest;
    }

    originalHandleRequest = fetch(
      "/collections/cn1-original-fragrances/products.json?limit=250",
      {
        credentials: "same-origin",
        headers: {
          Accept: "application/json"
        }
      }
    )
      .then(function (response) {
        if (!response.ok) {
          return { products: [] };
        }

        return response.json();
      })
      .then(function (data) {
        const map = {};

        (data.products || []).forEach(
          function (item) {
            if (item && item.handle) {
              map[item.handle] = true;
            }
          }
        );

        return map;
      })
      .catch(function () {
        originalHandleRequest = null;
        return {};
      });

    return originalHandleRequest;
  }

  async function withOriginalFlags(products) {
    const handles =
      await originalHandleMap();

    return (products || []).map(
      function (product) {
        const inspired =
          product.inspired_by ||
          inspiredByName(
            product.description || ""
          );

        const isOriginal =
          product.cn1_original === true ||
          Boolean(
            handles[product.handle]
          ) ||
          /cn1\s*originals?/i.test(
            String(inspired || "")
          );

        return Object.assign(
          {},
          product,
          {
            cn1_original: isOriginal,
            inspired_by: isOriginal
              ? "CN1 Original"
              : inspired
          }
        );
      }
    );
  }

  function keepMatchedProducts(products, query) {
    const scentTerms =
      wordsPresent(query, DNA_WORDS);

    if (!scentTerms.length) {
      return products || [];
    }

    return (products || []).filter(
      function (product) {
        return matchCopy(
          product,
          query
        ).percent > 0;
      }
    );
  }

  function renderProductCards(products) {
    const matchedProducts =
      keepMatchedProducts(
        products,
        lastGuestQuery
      );

    if (!matchedProducts.length) {
      updateGuestPanel(
        lastGuestQuery,
        0
      );
      return;
    }

    const limited =
      matchedProducts.slice(
        0,
        MAX_DISPLAY_PRODUCTS
      );

    const row =
      document.createElement("div");

    row.className =
      "chat-row bot";

    let html =
      "<div class='product-grid' data-count='" +
      limited.length +
      "' style='--card-count:" +
      limited.length +
      "'>";

    limited.forEach(
      function (
        product,
        index
      ) {
        html +=
          productCardHtml(
            product,
            index
          );
      }
    );

    html +=
      "</div>";

    const lastBubble =
      chatThread.querySelector(
        ".chat-row.bot:last-child .bot-bubble"
      );

    if (
      lastBubble &&
      !lastBubble.querySelector(
        ".product-grid"
      )
    ) {
      lastBubble.insertAdjacentHTML(
        "beforeend",
        html
      );
    } else {
      row.innerHTML = html;
      chatThread.appendChild(row);
    }

    updateGuestPanel(
      lastGuestQuery,
      limited.length
    );

    scrollThread();

    prefetchVariantIds(
      lastBubble || row
    );
  }

  function prefetchVariantIds(root) {
    if (!root) {
      return;
    }

    root
      .querySelectorAll(".add-to-cart")
      .forEach(function (button) {
        if (
          button.getAttribute(
            "data-variant-id"
          )
        ) {
          return;
        }

        const handle =
          button.getAttribute(
            "data-handle"
          );

        if (!handle) {
          return;
        }

        variantIdForHandle(handle)
          .then(function (variantId) {
            if (variantId) {
              button.setAttribute(
                "data-variant-id",
                variantId
              );
            }
          })
          .catch(function () {});
      });
  }

  function shopRoot() {
    return (
      window.Shopify &&
      Shopify.routes &&
      Shopify.routes.root
    ) || "/";
  }

  function openCartDrawer() {
    const drawer =
      document.querySelector("cart-drawer") ||
      document.getElementById("CartDrawer");

    if (!drawer) {
      return;
    }

    if (typeof drawer.show === "function") {
      drawer.show();
      return;
    }

    drawer.removeAttribute("hidden");
    drawer.setAttribute("open", "");
    drawer.classList.add("is-open", "active");
  }

  function publishCartUpdate(cart) {
    document.dispatchEvent(
      new CustomEvent("cart:updated", {
        detail: { cart: cart }
      })
    );

    if (
      window.FoxTheme &&
      FoxTheme.pubsub &&
      FoxTheme.pubsub.PUB_SUB_EVENTS
    ) {
      FoxTheme.pubsub.publish(
        FoxTheme.pubsub.PUB_SUB_EVENTS.cartUpdate,
        { cart: cart }
      );
    }
  }

  function variantIdForHandle(handle) {
    return fetch(
      shopRoot() +
        "products/" +
        encodeURIComponent(handle) +
        ".js",
      {
        headers: {
          Accept: "application/json"
        },
        credentials: "same-origin"
      }
    )
      .then(function (response) {
        if (!response.ok) {
          throw new Error("product_not_found");
        }

        return response.json();
      })
      .then(function (product) {
        return firstVariantId(product);
      });
  }

  function addVariantToCart(variantId) {
    const addUrl =
      (window.FoxTheme &&
        FoxTheme.routes &&
        FoxTheme.routes.cart_add_url) ||
      shopRoot() + "cart/add.js";

    return fetch(addUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Accept: "application/json",
        "X-Requested-With": "XMLHttpRequest"
      },
      credentials: "same-origin",
      body: JSON.stringify({
        id: Number(variantId),
        quantity: 1
      })
    })
      .then(function (response) {
        return response.json().then(function (added) {
          if (
            !response.ok ||
            (added && added.status)
          ) {
            throw new Error(
              (added &&
                (added.description ||
                  added.message)) ||
                "cart_add_failed"
            );
          }

          openCartDrawer();
          refreshCartDrawer();
        });
      });
  }

  function refreshCartDrawer() {
    const sections = [];

    document.documentElement.dispatchEvent(
      new CustomEvent("cart:grouped-sections", {
        bubbles: true,
        detail: { sections: sections }
      })
    );

    const cartUrl =
      (window.FoxTheme &&
        FoxTheme.routes &&
        FoxTheme.routes.cart_url) ||
      shopRoot() + "cart.js";

    const jobs = [
      fetch(cartUrl, {
        headers: {
          Accept: "application/json"
        },
        credentials: "same-origin"
      }).then(function (response) {
        return response.ok ? response.json() : {};
      })
    ];

    if (sections.length) {
      jobs.push(
        fetch(
          shopRoot() +
            "?sections=" +
            encodeURIComponent(
              sections.join(",")
            ),
          {
            headers: {
              Accept: "application/json"
            },
            credentials: "same-origin"
          }
        ).then(function (response) {
          return response.ok ? response.json() : null;
        })
      );
    }

    Promise.all(jobs)
      .then(function (result) {
        const cart = result[0] || {};

        if (result[1]) {
          cart.sections = result[1];
        }

        publishCartUpdate(cart);
        openCartDrawer();
      })
      .catch(function () {});
  }

  function addToCartFromCard(button) {
    if (
      !button ||
      button.disabled
    ) {
      return;
    }

    const handle = button.getAttribute("data-handle");
    const knownId = button.getAttribute("data-variant-id");

    button.disabled = true;
    button.textContent = "Adding...";

    const ready = knownId
      ? Promise.resolve(knownId)
      : variantIdForHandle(handle);

    ready
      .then(function (variantId) {
        if (!variantId) {
          throw new Error("missing_variant");
        }

        button.setAttribute(
          "data-variant-id",
          variantId
        );

        return addVariantToCart(variantId);
      })
      .then(function () {
        button.textContent = "Added";
      })
      .catch(function () {
        button.textContent = "Try again";
      })
      .finally(function () {
        button.disabled = false;
      });
  }

  /*
   * ---------------------------------------------------------
   * PRODUCT DISCOVERY
   * ---------------------------------------------------------
   *
   * IMPORTANT:
   *
   * Product cards do NOT depend on:
   * data.intent === "recommend"
   *
   * We always try to find products.
   *
   * Priority:
   *
   * 1. Products directly returned by API
   * 2. Handles/URLs returned by API
   * 3. Previous recommended products
   * 4. Shopify search using user's actual query
   * 5. Shopify search using AI reply
   * Product cards come from the API match.
   * An exact ingredient or best-seller answer never
   * falls back to a different product.
   */
  function readyToShow(list) {
    return (
      list.length &&
      list.every(function (product) {
        return (
          product &&
          product.title &&
          product.image
        );
      })
    );
  }

  async function discoverProducts(
    data,
    originalQuery
  ) {
    if (
      data &&
      data.exact_match === true
    ) {
      const direct =
        extractProducts(data);

      if (!direct.length) {
        return [];
      }

      if (readyToShow(direct)) {
        return direct.slice(
          0,
          MAX_DISPLAY_PRODUCTS
        );
      }

      const hydratedExact =
        await hydrateProducts(
          direct
        );

      return hydratedExact.length
        ? hydratedExact
        : [];
    }

    /*
     * 1. Direct API products.
     */
    let products =
      extractProducts(data);

    if (readyToShow(products)) {
      return products.slice(
        0,
        MAX_DISPLAY_PRODUCTS
      );
    }

    if (products.length) {
      const hydrated =
        await hydrateProducts(
          products
        );

      if (hydrated.length) {
        return hydrated;
      }
    }

    /*
     * 2. Previous products only for a follow-up
     * about a product already on screen.
     */
    const followUp =
      /\b(this|that|it|these|those|another one|the one|more about)\b/i.test(
        originalQuery || ""
      );

    if (
      followUp &&
      previousHandles.length
    ) {
      const previousProducts =
        previousHandles
          .slice(
            0,
            MAX_DISPLAY_PRODUCTS
          )
          .map(function (handle) {
            return {
              handle: handle,
              url:
                "/products/" +
                handle
            };
          });

      const hydratedPrevious =
        await hydrateProducts(
          previousProducts
        );

      if (
        hydratedPrevious.length
      ) {
        return hydratedPrevious;
      }
    }

    /*
     * 3. Search Shopify using the USER'S QUERY first.
     *
     * This is more reliable than searching the long AI
     * explanation.
     */
    if (originalQuery) {
      products =
        await searchShopifyProducts(
          originalQuery
        );

      if (products.length) {
        const hydrated =
          await hydrateProducts(
            products
          );

        if (hydrated.length) {
          return hydrated;
        }
      }
    }

    return [];
  }

  /*
   * ---------------------------------------------------------
   * SHOPIFY CUSTOMER EMAIL
   * ---------------------------------------------------------
   */

  function submitEmailToShopify(email) {
    const params =
      new URLSearchParams();

    params.append(
      "form_type",
      "customer"
    );

    params.append(
      "utf8",
      "✓"
    );

    params.append(
      "contact[email]",
      email
    );

    params.append(
      "contact[tags]",
      "AI Scent Finder, email-marketing-consent, newsletter"
    );

    params.append(
      "contact[accepts_marketing]",
      "true"
    );

    fetch(
      "/contact",
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/x-www-form-urlencoded; charset=UTF-8",

          Accept:
            "application/json, text/javascript, */*; q=0.01",

          "X-Requested-With":
            "XMLHttpRequest"
        },

        body:
          params.toString(),

        credentials:
          "same-origin"
      }
    )
      .then(function (response) {
        if (!response.ok) {
          console.warn(
            "AI Scent Finder newsletter signup HTTP",
            response.status
          );
        }
      })
      .catch(function (err) {
        console.warn(
          "AI Scent Finder newsletter signup failed",
          err
        );
      });
  }

