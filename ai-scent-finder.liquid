<style>
  .shopify-section.ai-scent-finder-section {
    margin: 0 !important;
    padding: 0 !important;

    height: 100vh;
    max-height: 100vh;

    overflow: hidden;
  }

  .scent-finder-app,
  .scent-finder-app *,
  .scent-finder-app *::before,
  .scent-finder-app *::after {
    box-sizing: border-box;
  }

  .scent-finder-app {
    --sf-coral: #ef4932;
    --sf-coral-dark: #d63a22;
    --sf-ink: #1a1009;
    --sf-muted: #6b5c52;
    --sf-line: #ede8e4;
    --sf-glass: #ffffff;

    --sf-bg-glow-1: rgba(239, 73, 50, 0.13);
    --sf-bg-glow-2: rgba(245, 158, 11, 0.1);
    --sf-bg-glow-3: rgba(251, 113, 60, 0.09);
    --sf-mood-hex: rgba(239, 73, 50, 0.18);

    --header-offset: var(--header-height, 72px);

    position: relative;
    width: 100%;
    height: 100vh;
    max-height: 100vh;
    min-height: 0;
    overflow: hidden;

    display: flex;
    flex-direction: column;

    background:
      radial-gradient(
        ellipse 1300px 800px at 8% -12%,
        var(--sf-bg-glow-1),
        transparent 55%
      ),
      radial-gradient(
        ellipse 900px 600px at 96% 10%,
        var(--sf-bg-glow-2),
        transparent 50%
      ),
      radial-gradient(
        ellipse 600px 400px at 50% 108%,
        var(--sf-bg-glow-3),
        transparent 55%
      ),
      linear-gradient(
        160deg,
        #fffcfa 0%,
        #fff7f3 48%,
        #fffaf7 100%
      );

    color: var(--sf-ink);

    font-family:
      "Poppins",
      "Inter",
      "Helvetica Neue",
      Helvetica,
      Arial,
      sans-serif;

    transition: background 0.8s ease;
  }

  .scent-finder-app[data-mood="fresh"] {
    --sf-bg-glow-1: rgba(132, 204, 22, 0.18);
    --sf-bg-glow-2: rgba(74, 222, 128, 0.14);
    --sf-bg-glow-3: rgba(163, 230, 53, 0.12);
  }

  .scent-finder-app[data-mood="amber"] {
    --sf-bg-glow-1: rgba(245, 158, 11, 0.22);
    --sf-bg-glow-2: rgba(217, 119, 6, 0.18);
    --sf-bg-glow-3: rgba(251, 191, 36, 0.15);
  }

  .scent-finder-app[data-mood="night"] {
    --sf-bg-glow-1: rgba(220, 38, 38, 0.22);
    --sf-bg-glow-2: rgba(239, 73, 50, 0.2);
    --sf-bg-glow-3: rgba(185, 28, 28, 0.16);
  }

  .scent-finder-app[data-mood="floral"] {
    --sf-bg-glow-1: rgba(244, 63, 94, 0.2);
    --sf-bg-glow-2: rgba(251, 113, 133, 0.16);
    --sf-bg-glow-3: rgba(253, 164, 175, 0.14);
  }

  .scent-finder-app[data-mood="custom"] {
    --sf-bg-glow-1: var(--sf-mood-hex);
    --sf-bg-glow-2: rgba(245, 158, 11, 0.14);
    --sf-bg-glow-3: rgba(251, 113, 60, 0.1);
  }

  .scent-finder-app button,
  .scent-finder-app input {
    font-family: inherit;
    appearance: none;
    -webkit-appearance: none;
  }

  .scent-finder-app .sf-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .scent-finder-app .sf-mesh {
    position: absolute;
    inset: -20%;

    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(255, 255, 255, 0.72),
        transparent 32%
      ),
      radial-gradient(
        circle at 80% 30%,
        rgba(239, 73, 50, 0.07),
        transparent 28%
      ),
      radial-gradient(
        circle at 50% 90%,
        rgba(245, 158, 11, 0.06),
        transparent 34%
      );

    animation: sfMeshDrift 22s ease-in-out infinite alternate;
  }

  .scent-finder-app .sf-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(88px);
    opacity: 1;
    animation: sfOrbFloat 16s ease-in-out infinite;
  }

  .scent-finder-app .sf-orb-a {
    width: min(52vw, 580px);
    height: min(52vw, 580px);
    right: -12%;
    top: -8%;

    background:
      radial-gradient(
        circle,
        rgba(239, 73, 50, 0.28) 0%,
        rgba(239, 73, 50, 0) 70%
      );

    animation-duration: 18s;
  }

  .scent-finder-app .sf-orb-b {
    width: min(46vw, 500px);
    height: min(46vw, 500px);
    left: -14%;
    bottom: -15%;

    background:
      radial-gradient(
        circle,
        rgba(245, 158, 11, 0.22) 0%,
        rgba(245, 158, 11, 0) 70%
      );

    animation-duration: 21s;
    animation-delay: -4s;
  }

  .scent-finder-app .sf-orb-c {
    width: min(32vw, 340px);
    height: min(32vw, 340px);
    left: 36%;
    top: -10%;

    background:
      radial-gradient(
        circle,
        rgba(251, 146, 60, 0.2) 0%,
        rgba(251, 146, 60, 0) 70%
      );

    animation-duration: 14s;
    animation-delay: -7s;
  }

  .scent-finder-app .sf-orb-d {
    width: min(28vw, 300px);
    height: min(28vw, 300px);
    right: 14%;
    bottom: 4%;

    background:
      radial-gradient(
        circle,
        rgba(220, 38, 38, 0.16) 0%,
        rgba(220, 38, 38, 0) 70%
      );

    animation-duration: 19s;
    animation-delay: -2s;
  }

  @keyframes sfMeshDrift {
    from {
      transform: translate3d(-2%, -1%, 0) scale(1);
    }

    to {
      transform: translate3d(3%, 2%, 0) scale(1.06);
    }
  }

  @keyframes sfOrbFloat {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(18px, -22px, 0) scale(1.08);
    }
  }

  .scent-finder-app .scent-finder-content {
    position: relative;
    z-index: 5;

    flex: 1 1 auto;

    width: 100%;
    min-height: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scent-finder-app .finder-step {
    width: 100%;
    min-height: 0;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 28px 24px 8px;
  }

  .scent-finder-app .finder-step.active {
    display: flex;
    flex: 1 1 auto;

    min-height: 0;
    overflow: hidden;
    animation:
      scentFinderStepFadeIn
      0.55s
      cubic-bezier(.22, 1, .36, 1)
      both;
  }

  .scent-finder-app .chat-step.active {
    flex: 1 1 0%;
    height: 0;

    animation: none;
    transform: none;
  }

  @keyframes scentFinderStepFadeIn {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .scent-finder-app .sf-card {
    width: 100%;

    background: #fff;
    border: 1px solid var(--sf-line);
    border-radius: 16px;

    box-shadow:
      0 12px 40px rgba(15, 23, 42, 0.07);
  }

  .scent-finder-app .sf-kicker {
    margin: 0 0 12px;

    color: var(--sf-coral);

    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .scent-finder-app .ai-icon {
    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 20px;

    border-radius: 50%;

    background:
      linear-gradient(
        180deg,
        #fff,
        rgba(255, 255, 255, 0.7)
      );

    box-shadow:
      0 10px 30px rgba(229, 107, 93, 0.18);

    animation: sfIconPulse 3.6s ease-in-out infinite;
  }

  .scent-finder-app .ai-icon svg {
    width: 30px;
    height: 30px;
  }

  @keyframes sfIconPulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow:
        0 10px 30px rgba(229, 107, 93, 0.16);
    }

    50% {
      transform: scale(1.04);
      box-shadow:
        0 14px 36px rgba(229, 107, 93, 0.28);
    }
  }

  .scent-finder-app .landing-step {
    padding: 56px 32px 28px;
  }

  .scent-finder-app .finder-step.landing-step.active {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;

    overflow-x: hidden;
    overflow-y: auto;
  }

  .scent-finder-app .landing-inner {
    width: 100%;
    max-width: 820px;
    margin-top: auto;
    margin-bottom: auto;
    padding: 0 12px 12px;

    background: transparent;
    border: 0;
    box-shadow: none;

    text-align: center;
  }

  .scent-finder-app .landing-inner .ai-icon {
    display: none;
  }

  .scent-finder-app .scent-mist {
    position: relative;

    width: 140px;
    height: 56px;

    margin: 0 auto 4px;

    pointer-events: none;
  }

  .scent-finder-app .scent-mist span {
    position: absolute;
    bottom: 6px;
    left: 50%;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: rgba(239, 73, 50, 0.45);

    animation: sfMistRise 4.2s ease-in infinite;
  }

  .scent-finder-app .scent-mist span:nth-child(1) {
    margin-left: -34px;
    animation-delay: 0s;
  }

  .scent-finder-app .scent-mist span:nth-child(2) {
    margin-left: -16px;
    width: 5px;
    height: 5px;
    animation-delay: 0.7s;
  }

  .scent-finder-app .scent-mist span:nth-child(3) {
    margin-left: -2px;
    animation-delay: 1.3s;
  }

  .scent-finder-app .scent-mist span:nth-child(4) {
    margin-left: 14px;
    width: 6px;
    height: 6px;
    animation-delay: 0.4s;
  }

  .scent-finder-app .scent-mist span:nth-child(5) {
    margin-left: 30px;
    width: 4px;
    height: 4px;
    animation-delay: 1.8s;
  }

  @keyframes sfMistRise {
    0% {
      transform: translateY(0) scale(0.5);
      opacity: 0;
    }

    18% {
      opacity: 0.7;
    }

    100% {
      transform: translateY(-42px) scale(1.35);
      opacity: 0;
    }
  }

  .scent-finder-app .landing-inner .sf-kicker {
    display: inline-flex;
    align-items: center;

    margin: 0 0 18px;
    padding: 7px 12px;

    border: 1px solid #f6e4df;
    border-radius: 999px;

    background: rgba(255, 255, 255, 0.72);

    letter-spacing: 0.14em;
  }

  .scent-finder-app .landing-inner .landing-title,
  .scent-finder-app .landing-inner .landing-question {
    text-align: center;
  }

  .scent-finder-app .landing-inner .landing-title strong {
    color: var(--sf-coral);
    font-style: italic;
    font-weight: 600;
  }

  .scent-finder-app .landing-inner .landing-question {
    justify-content: center;
    max-width: 560px;
    margin-right: auto;
    margin-left: auto;
  }

  .scent-finder-app .landing-inner .info-dot {
    display: none;
  }

  .scent-finder-app .landing-title,
  .scent-finder-app .email-title,
  .scent-finder-app .chat-title {
    margin: 0 0 14px;

    color: var(--sf-ink);

    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .scent-finder-app .landing-title {
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.08;
  }

  .scent-finder-app .landing-title strong,
  .scent-finder-app .email-title strong,
  .scent-finder-app .chat-title strong {
    font-weight: 700;
    color: var(--sf-ink);
  }

  .scent-finder-app .landing-question,
  .scent-finder-app .email-subtitle,
  .scent-finder-app .chat-description {
    margin: 0 0 28px;

    color: var(--sf-muted);

    font-size: 16px;
    line-height: 1.55;
  }

  .scent-finder-app .landing-question {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .scent-finder-app .info-dot {
    width: 18px;
    height: 18px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.7);
    color: rgba(27, 23, 20, 0.45);

    font-size: 10px;
    font-weight: 700;

    cursor: help;
  }

  .scent-finder-app .landing-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 28px;

    width: 100%;
    max-width: 860px;

    margin: 6px auto 28px;
  }

  .scent-finder-app .landing-option {
    width: 100%;
    min-width: 0;
    min-height: 0;

    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;

    padding: 10px 12px;

    border: 1px solid transparent;
    border-radius: 12px;

    background: transparent;
    color: var(--sf-ink);

    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    text-align: left;
    text-transform: none;

    cursor: pointer;

    overflow: hidden;

    animation:
      scentFinderStepFadeIn
      0.5s
      ease
      both;

    transition:
      background-color 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }

  .scent-finder-app .landing-option-icon {
    flex: 0 0 auto;

    width: 25px;
    height: 25px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 0;

    background: transparent;
    color: var(--sf-coral);

    transition: filter 0.22s ease;
  }

  .scent-finder-app .landing-option-icon svg {
    width: 25px;
    height: 25px;
    overflow: visible;
  }

  .scent-finder-app .icon-spark svg {
    transform-origin: center;
    animation: sfSpark 1.6s ease-in-out infinite;
  }

  .scent-finder-app .icon-drop svg {
    transform-origin: center bottom;
    animation: sfDrop 1.5s ease-in-out infinite;
  }

  .scent-finder-app .icon-chart svg path {
    stroke-dasharray: 32;
    animation: sfChart 2s ease-in-out infinite;
  }

  .scent-finder-app .icon-moon svg {
    transform-origin: center;
    animation: sfMoon 2.2s ease-in-out infinite;
  }

  @keyframes sfSpark {
    0%,
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }

    50% {
      transform: scale(1.18) rotate(14deg);
      opacity: 0.72;
    }
  }

  @keyframes sfDrop {
    0%,
    100% {
      transform: translateY(0) scale(1, 1);
    }

    45% {
      transform: translateY(2px) scale(0.9, 1.08);
    }

    70% {
      transform: translateY(-1px) scale(1.04, 0.96);
    }
  }

  @keyframes sfChart {
    0% {
      stroke-dashoffset: 32;
    }

    55%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes sfMoon {
    0%,
    100% {
      transform: rotate(-10deg);
    }

    50% {
      transform: rotate(10deg);
    }
  }

  .scent-finder-app .landing-option-label {
    flex: 1 1 auto;
    min-width: 0;

    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;

    white-space: normal;
  }

  .scent-finder-app .landing-option-arrow {
    display: none;
  }

  .scent-finder-app .landing-option-arrow svg {
    display: block;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
  }

  .scent-finder-app .landing-option:nth-child(1) {
    animation-delay: 0.05s;
  }

  .scent-finder-app .landing-option:nth-child(2) {
    animation-delay: 0.1s;
  }

  .scent-finder-app .landing-option:nth-child(3) {
    animation-delay: 0.15s;
  }

  .scent-finder-app .landing-option:nth-child(4) {
    animation-delay: 0.2s;
  }

  .scent-finder-app .landing-option:hover,
  .scent-finder-app .landing-option:focus-visible {
    transform: none;
    background: #fff;
    color: var(--sf-ink);

    border-color: #f3ebe7;

    box-shadow:
      0 6px 16px rgba(26, 16, 9, 0.06);
  }

  .scent-finder-app .landing-option:hover .landing-option-label,
  .scent-finder-app .landing-option:focus-visible .landing-option-label,
  .scent-finder-app .landing-option.is-active .landing-option-label {
    color: var(--sf-ink);
  }

  .scent-finder-app .landing-option:hover .landing-option-icon,
  .scent-finder-app .landing-option:focus-visible .landing-option-icon,
  .scent-finder-app .landing-option.is-active .landing-option-icon {
    background: transparent;
    color: var(--sf-coral);
    filter: none;
  }

  .scent-finder-app .landing-option:active,
  .scent-finder-app .landing-option.is-active {
    transform: none;
    background: #fff;
    color: var(--sf-ink);
    border-color: #f0e4df;

    box-shadow:
      0 8px 18px rgba(26, 16, 9, 0.08);
  }

  .scent-finder-app .landing-input,
  .scent-finder-app .email-input,
  .scent-finder-app .chat-input {
    position: relative;

    width: 100%;

    display: flex;
    align-items: center;

    background: #fff;

    border: 1px solid var(--sf-line);
  }

  .scent-finder-app .landing-input,
  .scent-finder-app .email-input {
    height: 52px;

    padding: 0 60px 0 18px;

    border-radius: 12px;

    box-shadow: none;
  }

  .scent-finder-app .landing-input {
    position: relative;
    z-index: 3;

    max-width: 720px;
    height: 58px;

    margin: 0 auto;
    padding: 0 8px 0 18px;

    border: 1px solid #f3ebe7;
    border-radius: 999px;

    box-shadow:
      0 14px 34px rgba(40, 28, 20, 0.07);
  }

  .scent-finder-app .landing-input input {
    position: relative;
    z-index: 1;

    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    height: 100%;
  }

  .scent-finder-app .landing-inner .coral-arrow {
    position: relative;
    top: auto;
    right: auto;

    flex: 0 0 auto;
    z-index: 2;

    width: 40px !important;
    height: 40px !important;
    min-width: 40px;

    border-radius: 50%;

    transform: none;
  }

  .scent-finder-app .landing-inner .coral-arrow:hover {
    transform: scale(1.06);
  }

  .scent-finder-app .landing-input input,
  .scent-finder-app .email-input input,
  .scent-finder-app .chat-input input {
    width: 100%;
    height: 100%;

    border: 0 !important;
    outline: 0;
    border-radius: 999px;

    appearance: none;
    -webkit-appearance: none;

    background: transparent !important;
    background-color: transparent !important;

    box-shadow: none !important;

    color: var(--sf-ink);
    -webkit-text-fill-color: var(--sf-ink);

    font-size: 16px;
  }

  .scent-finder-app .landing-input input:focus,
  .scent-finder-app .email-input input:focus,
  .scent-finder-app .chat-input input:focus,
  .scent-finder-app .landing-input input:active,
  .scent-finder-app .email-input input:active,
  .scent-finder-app .chat-input input:active {
    background: transparent !important;
    background-color: transparent !important;
    box-shadow: none !important;
  }

  .scent-finder-app .landing-input input:-webkit-autofill,
  .scent-finder-app .landing-input input:-webkit-autofill:hover,
  .scent-finder-app .landing-input input:-webkit-autofill:focus,
  .scent-finder-app .email-input input:-webkit-autofill,
  .scent-finder-app .email-input input:-webkit-autofill:hover,
  .scent-finder-app .email-input input:-webkit-autofill:focus,
  .scent-finder-app .chat-input input:-webkit-autofill,
  .scent-finder-app .chat-input input:-webkit-autofill:hover,
  .scent-finder-app .chat-input input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--sf-ink) !important;
    caret-color: var(--sf-ink);

    border-radius: 999px;

    transition: background-color 99999s ease-out 0s;

    -webkit-box-shadow: 0 0 0 1000px #fff inset !important;
    box-shadow: 0 0 0 1000px #fff inset !important;
  }

  .scent-finder-app .landing-input input::placeholder,
  .scent-finder-app .email-input input::placeholder,
  .scent-finder-app .chat-input input::placeholder {
    color: #8a8178;
    opacity: 1;
  }

  .scent-finder-app .coral-arrow {
    position: absolute;

    top: 50%;
    right: 6px;

    width: 44px !important;
    height: 44px !important;

    min-width: 44px;

    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;
    border-radius: 10px;

    transform: translateY(-50%);

    background: var(--sf-coral) !important;
    color: #fff !important;

    font-size: 18px;
    font-weight: 400;
    line-height: 1;

    cursor: pointer;

    box-shadow:
      0 8px 18px rgba(229, 107, 93, 0.28);

    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }

  .scent-finder-app .coral-arrow:hover {
    filter: brightness(1.04);
    transform: translateY(-50%) scale(1.06);
  }

  .scent-finder-app .coral-arrow:disabled,
  .scent-finder-app .ask-button:disabled,
  .scent-finder-app .chat-chip:disabled,
  .scent-finder-app .landing-option:disabled {
    opacity: 0.55;
    cursor: not-allowed;
