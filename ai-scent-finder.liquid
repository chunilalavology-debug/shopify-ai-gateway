<script>
(function () {
  "use strict";

  const sectionId = {{ section.id | json }};

  const AI_ENDPOINT =
    {{ section.settings.api_endpoint | json }} ||
    "https://shopify-ai-gateway-rosy.vercel.app/api/recommend";

  const MAX_ASKS =
    Number({{ section.settings.max_asks | default: 20 | json }}) || 20;

  // Temporarily off. Set to true to restore the free-message cap.
  const USAGE_LIMIT_ENABLED = false;

  const MAX_INPUT_WORDS = 800;

  const HISTORY_LIMIT = 8;

  const MAX_DISPLAY_PRODUCTS = 4;

  /*
   * HARD FRONTEND DISPLAY LIMIT
   *
   * The customer will NEVER see more than 100 characters
   * from the AI reply.
   */
  const MAX_REPLY_CHARS = 100;

  const MONEY_FORMAT =
    {{ shop.money_format | json }};

  const QUOTA_KEY =
    "ai-scent-finder-quota-v3";

  const SESSION_KEY =
    "ai-scent-finder-session-v1";

  const WINDOW_MS =
    24 * 60 * 60 * 1000;

  const DAILY_LIMIT_MESSAGE =
    "You've reached your free chat limit for today. Please come back tomorrow and we'll be happy to help!";

  const app =
    document.getElementById(
      "scent-finder-app-" + sectionId
    );

  const landingQuery =
    document.getElementById(
      "landing-query-" + sectionId
    );

  const landingSubmit =
    document.getElementById(
      "landing-submit-" + sectionId
    );

  const customerEmailInput =
    document.getElementById(
      "customer-email-" + sectionId
    );

  const emailSubmit =
    document.getElementById(
      "email-submit-" + sectionId
    );

  const emailError =
    document.getElementById(
      "email-error-" + sectionId
    );

  const chatQuery =
    document.getElementById(
      "chat-query-" + sectionId
    );

  const chatSubmit =
    document.getElementById(
      "chat-submit-" + sectionId
    );

  const chatThread =
    document.getElementById(
      "chat-thread-" + sectionId
    );

  const restartButton =
    document.getElementById(
      "restart-button-" + sectionId
    );

  const guestAvatar =
    document.getElementById(
      "guest-avatar-" + sectionId
    );

  const guestName =
    document.getElementById(
      "guest-name-" + sectionId
    );

  const guestEmail =
    document.getElementById(
      "guest-email-" + sectionId
    );

  const guestLooking =
    document.getElementById(
      "guest-looking-" + sectionId
    );

  const guestMatches =
    document.getElementById(
      "guest-matches-" + sectionId
    );

  const shopCustomerName =
    {{ customer.name | default: '' | json }};

  const quotaPills =
    document.getElementById(
      "quota-pills-" + sectionId
    );

  const quotaDots =
    document.getElementById(
      "quota-dots-" + sectionId
    );

  const quotaLabel =
    document.getElementById(
      "quota-label-" + sectionId
    );

  const quotaNote =
    document.getElementById(
      "quota-note-" + sectionId
    );

  if (
    !app ||
    !landingQuery ||
    !landingSubmit ||
    !customerEmailInput ||
    !emailSubmit ||
    !chatQuery ||
    !chatSubmit ||
    !chatThread ||
    !restartButton
  ) {
    return;
  }

  let selectedQuery = "";

  let lastGuestQuery = "";
  let customerEmail = "";
  let isBusy = false;
  let limitReached = false;

  let conversation = [];

  let previousHandles = [];

  function escapeHtml(value) {
    return String(value == null ? "" : value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function stripHtml(value) {
    const box = document.createElement("div");

    box.innerHTML = value || "";

    return (
      box.textContent ||
      box.innerText ||
      ""
    )
      .replace(/\s+/g, " ")
      .trim();
  }

  function formatMoney(cents) {
    const numeric = Number(cents);

    if (!isFinite(numeric)) {
      return "";
    }

    const amount = (numeric / 100).toFixed(2);

    if (!MONEY_FORMAT) {
      return "$" + amount;
    }

    return String(MONEY_FORMAT)
      .replace(
        /\{\{\s*amount\s*\}\}/g,
        amount
      )
      .replace(
        /\{\{\s*amount_no_decimals\s*\}\}/g,
        String(Math.round(numeric / 100))
      )
      .replace(
        /\{\{\s*amount_with_comma_separator\s*\}\}/g,
        amount.replace(".", ",")
      );
  }

  function withHttps(url) {
    if (!url) {
      return "";
    }

    const value = String(url).trim();

    if (value.indexOf("//") === 0) {
      return "https:" + value;
    }

    return value;
  }

  /*
   * ---------------------------------------------------------
   * HARD 100 CHARACTER AI RESPONSE
   * ---------------------------------------------------------
   *
   * This is the final frontend safety layer.
   * Even if the backend sends 500 characters,
   * only 100 characters can be displayed.
   */
  function shortenAiReply(value) {
    let text = stripHtml(value);

    if (!text) {
      return "Here are a few scents that match.";
    }

    text = text
      .replace(/\r\n/g, " ")
      .replace(/\n+/g, " ")
      .replace(/\*\*/g, "")
      .replace(/__/g, "")
      .replace(/^#{1,6}\s*/g, "")
      .replace(/\s+/g, " ")
      .trim();

    /*
     * Prefer complete sentences first.
     */
    const sentenceMatches =
      text.match(
        /[^.!?]+[.!?]+(?=\s|$)|[^.!?]+$/g
      );

    if (
      sentenceMatches &&
      sentenceMatches.length
    ) {
      text = sentenceMatches
        .slice(-2)
        .map(function (sentence) {
          return sentence.trim();
        })
        .filter(Boolean)
        .join(" ");
    }

    const words = text.split(/\s+/).filter(Boolean);

    if (words.length > 24) {
      text = words.slice(-24).join(" ");
    }

    return text;
  }

  function getQuota() {
    try {
      const parsed =
        JSON.parse(
          localStorage.getItem(
            QUOTA_KEY
          ) || "null"
        );

      if (
        !parsed ||
        Date.now() > Number(parsed.reset)
      ) {
        return {
          count: 0,
          reset:
            Date.now() + WINDOW_MS
        };
      }

      return {
        count:
          Math.max(
            0,
            Number(parsed.count) || 0
          ),
        reset:
          Number(parsed.reset)
      };
    } catch (err) {
      return {
        count: 0,
        reset:
          Date.now() + WINDOW_MS
      };
    }
  }

  function saveQuota(quota) {
    try {
      localStorage.setItem(
        QUOTA_KEY,
        JSON.stringify(quota)
      );
    } catch (err) {}
  }

  function remainingAsks() {
    if (!USAGE_LIMIT_ENABLED) {
      return MAX_ASKS;
    }

    return Math.max(
      0,
      MAX_ASKS - getQuota().count
    );
  }

  function countWords(value) {
    const trimmed =
      String(value || "").trim();

    if (!trimmed) {
      return 0;
    }

    return trimmed.split(/\s+/).length;
  }

  function syncRemainingFromServer(remaining) {
    if (
      typeof remaining !== "number" ||
      !isFinite(remaining)
    ) {
      return;
    }

    const quota = getQuota();

    quota.count =
      Math.max(
        0,
        Math.min(
          MAX_ASKS,
          MAX_ASKS -
            Math.max(0, remaining)
        )
      );

    saveQuota(quota);

    renderQuota();
  }

  function getSessionId() {
    try {
      let id =
        localStorage.getItem(
          SESSION_KEY
        );

      if (!id) {
        id =
          window.crypto &&
          crypto.randomUUID
            ? crypto.randomUUID()
            : "s" +
              Date.now() +
              Math.random()
                .toString(16)
                .slice(2);

        localStorage.setItem(
          SESSION_KEY,
          id
        );
      }

      return id;
    } catch (err) {
      return "s" + Date.now();
    }
  }

  function markAskUsed() {
    const quota = getQuota();

    quota.count += 1;

    saveQuota(quota);

    renderQuota();
  }

  function forceLimit() {
    const quota = getQuota();

    quota.count = MAX_ASKS;

    saveQuota(quota);

    limitReached = true;

    renderQuota();

    setChatEnabled(false);
  }

  function renderQuota() {
    if (!USAGE_LIMIT_ENABLED) {
      limitReached = false;

      if (quotaPills) {
        quotaPills.hidden = true;
      }

      if (quotaNote) {
        quotaNote.hidden = true;
      }

      return;
    }

    if (quotaPills) {
      quotaPills.hidden = false;
    }

    if (quotaNote) {
      quotaNote.hidden = false;
    }

    const left = remainingAsks();

    limitReached = left <= 0;

    if (quotaDots) {
      quotaDots.innerHTML = "";

      const visualDots =
        Math.min(MAX_ASKS, 10);

      const usedVisual =
        visualDots -
        Math.ceil(
          (left / MAX_ASKS) *
            visualDots
        );

      for (
        let i = 0;
        i < visualDots;
        i += 1
      ) {
        const dot =
          document.createElement("span");

        if (i < usedVisual) {
          dot.className = "used";
        }

        quotaDots.appendChild(dot);
      }
    }

    if (quotaLabel) {
      quotaLabel.textContent =
        left === 1
          ? "1 message left today"
          : left +
            " messages left today";
    }

    if (quotaNote) {
      quotaNote.textContent =
        limitReached
          ? "Daily free limit reached. Please come back tomorrow."
          : "You have " +
            left +
            " free message" +
            (left === 1 ? "" : "s") +
            " left today.";
    }
  }

  function setChatEnabled(enabled) {
    const allow =
      enabled &&
      !isBusy &&
      !limitReached;

    chatQuery.disabled = !allow;
    chatSubmit.disabled = !allow;

    app
      .querySelectorAll(
        ".chat-chip[data-chat-query]"
      )
      .forEach(function (chip) {
        chip.disabled = !allow;
      });

    if (limitReached) {
      chatQuery.placeholder =
        "Daily free limit reached — come back tomorrow";
    } else {
      chatQuery.placeholder =
        "Type a message";
    }
  }

  function showStep(stepNumber) {
    app
      .querySelectorAll(".finder-step")
      .forEach(function (step) {
        step.classList.remove("active");
      });

    const target =
      document.getElementById(
        "step-" +
          stepNumber +
          "-" +
          sectionId
      );

    if (target) {
      target.classList.add("active");
    }

    window.setTimeout(function () {
      if (stepNumber === 1) {
        landingQuery.focus();
      }

      if (stepNumber === 2) {
        customerEmailInput.focus();
      }

      if (
        stepNumber === 3 &&
        !limitReached
      ) {
        chatQuery.focus();
      }
    }, 350);
  }

  function updateMoodBackground(query, hex) {
    if (
      hex &&
      /^#[0-9a-fA-F]{3,8}$/.test(hex)
    ) {
      app.style.setProperty(
        "--sf-mood-hex",
        hex
      );

      app.setAttribute(
        "data-mood",
        "custom"
      );

      return;
    }

    app.style.removeProperty(
      "--sf-mood-hex"
    );

    const normalized =
      String(query || "")
        .toLowerCase();

    if (
      /fresh|brunch|clean|citrus|summer|green/.test(
        normalized
      )
    ) {
      app.setAttribute(
        "data-mood",
        "fresh"
      );
    } else if (
      /tobacco|vanilla|warm|amber|cozy/.test(
        normalized
      )
    ) {
      app.setAttribute(
        "data-mood",
        "amber"
      );
    } else if (
      /sexy|date|night|seductive/.test(
        normalized
      )
    ) {
      app.setAttribute(
        "data-mood",
        "night"
      );
    } else if (
      /floral|rose|jasmine/.test(
        normalized
      )
    ) {
      app.setAttribute(
        "data-mood",
        "floral"
      );
    } else {
      app.setAttribute(
        "data-mood",
        "default"
      );
    }
  }

