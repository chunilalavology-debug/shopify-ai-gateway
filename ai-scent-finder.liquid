  </div>

  <div class="scent-finder-content">
    <ol class="sf-progress" aria-label="Scent finder steps">
      <li class="sf-progress-step is-active" data-step="1"><span>1</span> Scent</li>
      <li class="sf-progress-line" data-line="1" aria-hidden="true"><em></em></li>
      <li class="sf-progress-step" data-step="2"><span>2</span> Email</li>
