    <section class="finder-step" id="step-2-{{ section.id }}">
      <div class="sf-card email-inner">
        <div class="ai-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 5C20.8 13.7 26.3 19.2 35 20C26.3 20.8 20.8 26.3 20 35C19.2 26.3 13.7 20.8 5 20C13.7 19.2 19.2 13.7 20 5Z" stroke="#E56B5D" stroke-width="1.8"/>
          </svg>
        </div>
        <p class="sf-kicker">Step 2 of 3</p>
        <h2 class="email-title">{{ section.settings.step2_heading_prefix | default: "Let's help you discover " }}<strong>{{ section.settings.step2_heading_bold | default: 'Fragrances tailored to you.' }}</strong></h2>
        <p class="email-subtitle">{{ section.settings.step2_subtitle | default: 'Please enter your email to get started.' }}</p>

