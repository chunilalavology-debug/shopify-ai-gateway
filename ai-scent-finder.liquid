        </p>

        <div class="landing-options">
          <button type="button" class="landing-option" data-query="{{ section.settings.option1_query | default: 'A scent with amber notes' | escape }}">{{ section.settings.option1_label | default: 'A scent with amber notes' }}</button>
          <button type="button" class="landing-option" data-query="{{ section.settings.option2_query | default: 'A perfume to wear to weekend brunch' | escape }}">{{ section.settings.option2_label | default: 'A perfume to wear to weekend brunch' }}</button>
          <button type="button" class="landing-option" data-query="{{ section.settings.option3_query | default: "Smell like Tom Ford's Tobacco Vanille" | escape }}">{{ section.settings.option3_label | default: "Smell like Tom Ford's Tobacco Vanille" }}</button>
          <button type="button" class="landing-option" data-query="{{ section.settings.option4_query | default: 'Perfume that makes me feel sexy' | escape }}">{{ section.settings.option4_label | default: 'Perfume that makes me feel sexy' }}</button>
        </div>

        <div class="landing-input">
          <input
            type="text"
            id="landing-query-{{ section.id }}"
            placeholder="{{ section.settings.step1_placeholder | default: 'Or type what you are looking for' | escape }}"
            autocomplete="off"
            maxlength="500"
            aria-label="What are you looking for?"
          >
          <button type="button" class="coral-arrow" id="landing-submit-{{ section.id }}" aria-label="Continue">→</button>
        </div>
