

<style>
  .scent-finder-app,
  .scent-finder-app *,
  .scent-finder-app *::before,
  .scent-finder-app *::after {
    box-sizing: border-box;
  }

  .scent-finder-app {
    --sf-coral: #ef4932;
    --sf-coral-dark: #d63a22;
    --sf-ink: #1a1009;
    --sf-muted: #6b5c52;
    --sf-line: #ede8e4;
    --sf-glass: #ffffff;
    /* Warm brand palette — glow color vars */
    --sf-bg-glow-1: rgba(239, 73, 50, 0.13);
    --sf-bg-glow-2: rgba(245, 158, 11, 0.1);
    --sf-bg-glow-3: rgba(251, 113, 60, 0.09);
    --sf-mood-hex: rgba(239, 73, 50, 0.18);
    --header-offset: var(--header-height, 72px);
    position: relative;
    width: 100%;
    min-height: calc(100svh - var(--header-offset));
    overflow: hidden;
    background:
      radial-gradient(ellipse 1300px 800px at 8% -12%, var(--sf-bg-glow-1), transparent 55%),
      radial-gradient(ellipse 900px 600px at 96% 10%, var(--sf-bg-glow-2), transparent 50%),
      radial-gradient(ellipse 600px 400px at 50% 108%, var(--sf-bg-glow-3), transparent 55%),
      linear-gradient(160deg, #fffcfa 0%, #fff7f3 48%, #fffaf7 100%);
    color: var(--sf-ink);
    font-family: "Poppins", "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
    transition: background 0.8s ease;
  }

  /* Mood colour shifts — warm palette only, no blue or purple */
  .scent-finder-app[data-mood="fresh"] {
    --sf-bg-glow-1: rgba(132, 204, 22, 0.18);
    --sf-bg-glow-2: rgba(74, 222, 128, 0.14);
    --sf-bg-glow-3: rgba(163, 230, 53, 0.12);
  }

  .scent-finder-app[data-mood="amber"] {
    --sf-bg-glow-1: rgba(245, 158, 11, 0.22);
    --sf-bg-glow-2: rgba(217, 119, 6, 0.18);
    --sf-bg-glow-3: rgba(251, 191, 36, 0.15);
  }

  .scent-finder-app[data-mood="night"] {
    --sf-bg-glow-1: rgba(220, 38, 38, 0.22);
    --sf-bg-glow-2: rgba(239, 73, 50, 0.2);
    --sf-bg-glow-3: rgba(185, 28, 28, 0.16);
  }

  .scent-finder-app[data-mood="floral"] {
    --sf-bg-glow-1: rgba(244, 63, 94, 0.2);
    --sf-bg-glow-2: rgba(251, 113, 133, 0.16);
    --sf-bg-glow-3: rgba(253, 164, 175, 0.14);
  }

  .scent-finder-app[data-mood="custom"] {
    --sf-bg-glow-1: var(--sf-mood-hex);
    --sf-bg-glow-2: rgba(245, 158, 11, 0.14);
    --sf-bg-glow-3: rgba(251, 113, 60, 0.1);
  }

  .scent-finder-app button,
  .scent-finder-app input {
    font-family: inherit;
    appearance: none;
    -webkit-appearance: none;
  }

  .scent-finder-app .sf-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .scent-finder-app .sf-mesh {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.72), transparent 32%),
      radial-gradient(circle at 80% 30%, rgba(239, 73, 50, 0.07), transparent 28%),
      radial-gradient(circle at 50% 90%, rgba(245, 158, 11, 0.06), transparent 34%);
    animation: sfMeshDrift 22s ease-in-out infinite alternate;
  }

  .scent-finder-app .sf-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(88px);
    opacity: 1;
    animation: sfOrbFloat 16s ease-in-out infinite;
  }

  /* Brand coral glow — top right */
  .scent-finder-app .sf-orb-a {
    width: min(52vw, 580px);
    height: min(52vw, 580px);
    right: -12%;
    top: -8%;
    background: radial-gradient(circle, rgba(239, 73, 50, 0.28) 0%, rgba(239, 73, 50, 0) 70%);
    animation-duration: 18s;
  }

  /* Warm amber glow — bottom left */
  .scent-finder-app .sf-orb-b {
    width: min(46vw, 500px);
    height: min(46vw, 500px);
    left: -14%;
    bottom: -15%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.22) 0%, rgba(245, 158, 11, 0) 70%);
    animation-duration: 21s;
    animation-delay: -4s;
  }

  /* Warm peach glow — top centre */
  .scent-finder-app .sf-orb-c {
    width: min(32vw, 340px);
    height: min(32vw, 340px);
    left: 36%;
    top: -10%;
    background: radial-gradient(circle, rgba(251, 146, 60, 0.2) 0%, rgba(251, 146, 60, 0) 70%);
    animation-duration: 14s;
    animation-delay: -7s;
  }

  /* Deep coral glow — bottom right */
  .scent-finder-app .sf-orb-d {
    width: min(28vw, 300px);
    height: min(28vw, 300px);
    right: 14%;
    bottom: 4%;
    background: radial-gradient(circle, rgba(220, 38, 38, 0.16) 0%, rgba(220, 38, 38, 0) 70%);
    animation-duration: 19s;
    animation-delay: -2s;
  }

  @keyframes sfMeshDrift {
    from { transform: translate3d(-2%, -1%, 0) scale(1); }
    to { transform: translate3d(3%, 2%, 0) scale(1.06); }
  }

  @keyframes sfOrbFloat {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(18px, -22px, 0) scale(1.08); }
  }

  .scent-finder-app .scent-finder-content {
    position: relative;
    z-index: 5;
    width: 100%;
    min-height: calc(100svh - var(--header-offset));
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scent-finder-app .sf-progress {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: min(100% - 40px, 520px);
    margin: 28px auto 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .scent-finder-app .sf-progress-step {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(26, 16, 9, 0.38);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .scent-finder-app .sf-progress-step span {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(239, 73, 50, 0.07);
    border: 1px solid rgba(239, 73, 50, 0.2);
    font-size: 12px;
    font-weight: 600;
    color: rgba(26, 16, 9, 0.45);
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .scent-finder-app .sf-progress-step.is-active {
    color: var(--sf-ink);
  }

  .scent-finder-app .sf-progress-step.is-active span,
  .scent-finder-app .sf-progress-step.is-complete span {
    background: var(--sf-coral);
    color: #fff;
    border-color: transparent;
    transform: scale(1.05);
  }

  .scent-finder-app .sf-progress-step.is-complete {
    color: rgba(26, 16, 9, 0.5);
  }

  .scent-finder-app .sf-progress-line {
    flex: 1;
    height: 2px;
    max-width: 72px;
    border-radius: 2px;
    background: rgba(239, 73, 50, 0.12);
    overflow: hidden;
  }

  .scent-finder-app .sf-progress-line em {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--sf-coral), #f0a08e);
    transition: width 0.45s ease;
  }

  .scent-finder-app .sf-progress-line.is-filled em {
    width: 100%;
  }

  .scent-finder-app .finder-step {
    width: 100%;
    min-height: calc(100svh - var(--header-offset) - 64px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 36px 24px 88px;
  }

  .scent-finder-app .finder-step.active {
    display: flex;
    animation: scentFinderStepFadeIn 0.55s cubic-bezier(.22, 1, .36, 1) both;
  }

  @keyframes scentFinderStepFadeIn {
    from { opacity: 0; transform: translateY(18px) scale(0.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .scent-finder-app .sf-card {
    width: 100%;
    background: #fff;
    border: 1px solid var(--sf-line);
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(15, 23, 42, 0.07);
  }

  .scent-finder-app .sf-kicker {
    margin: 0 0 12px;
    color: var(--sf-coral);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .scent-finder-app .ai-icon {
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border-radius: 50%;
    background: linear-gradient(180deg, #fff, rgba(255, 255, 255, 0.7));
    box-shadow: 0 10px 30px rgba(229, 107, 93, 0.18);
    animation: sfIconPulse 3.6s ease-in-out infinite;
  }

  .scent-finder-app .ai-icon svg {
    width: 30px;
    height: 30px;
  }

  @keyframes sfIconPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 10px 30px rgba(229, 107, 93, 0.16); }
    50% { transform: scale(1.04); box-shadow: 0 14px 36px rgba(229, 107, 93, 0.28); }
  }

  .scent-finder-app .landing-inner {
    width: 100%;
    max-width: 760px;
    padding: 42px 42px 36px;
  }

  .scent-finder-app .landing-title,
  .scent-finder-app .email-title,
  .scent-finder-app .chat-title {
    margin: 0 0 14px;
    color: var(--sf-ink);
    font-weight: 400;
    letter-spacing: -0.035em;
  }

  .scent-finder-app .landing-title {
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.08;
  }

  .scent-finder-app .landing-title strong,
  .scent-finder-app .email-title strong,
  .scent-finder-app .chat-title strong {
    font-weight: 700;
    color: var(--sf-ink);
  }

  .scent-finder-app .landing-question,
  .scent-finder-app .email-subtitle,
  .scent-finder-app .chat-description {
    margin: 0 0 28px;
    color: var(--sf-muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .scent-finder-app .landing-question {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .scent-finder-app .info-dot {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    color: rgba(27, 23, 20, 0.45);
    font-size: 10px;
    font-weight: 700;
    cursor: help;
  }

  .scent-finder-app .landing-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    margin-bottom: 22px;
  }

  .scent-finder-app .landing-option {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 12px;
    background: #fff;
    color: var(--sf-ink);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    cursor: pointer;
    animation: scentFinderStepFadeIn 0.5s ease both;
    transition: transform 0.22s ease, background-color 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .scent-finder-app .landing-option:nth-child(1) { animation-delay: 0.05s; }
  .scent-finder-app .landing-option:nth-child(2) { animation-delay: 0.1s; }
  .scent-finder-app .landing-option:nth-child(3) { animation-delay: 0.15s; }
  .scent-finder-app .landing-option:nth-child(4) { animation-delay: 0.2s; }

  .scent-finder-app .landing-option:hover,
  .scent-finder-app .landing-option:focus-visible {
    transform: translateY(-3px);
    background: #fff;
    border-color: rgba(229, 107, 93, 0.35);
    box-shadow: 0 14px 30px rgba(229, 107, 93, 0.12);
  }

  .scent-finder-app .landing-input,
  .scent-finder-app .email-input,
  .scent-finder-app .chat-input {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    background: #fff;
    border: 1px solid var(--sf-line);
  }

  .scent-finder-app .landing-input,
  .scent-finder-app .email-input {
    height: 52px;
    padding: 0 60px 0 18px;
    border-radius: 12px;
    box-shadow: none;
  }

  .scent-finder-app .landing-input input,
  .scent-finder-app .email-input input,
  .scent-finder-app .chat-input input {
    width: 100%;
    border: 0 !important;
    outline: 0;
    background: transparent !important;
    box-shadow: none !important;
    color: var(--sf-ink);
    font-size: 16px;
  }

  .scent-finder-app .landing-input input::placeholder,
  .scent-finder-app .email-input input::placeholder,
  .scent-finder-app .chat-input input::placeholder {
    color: #8a8178;
    opacity: 1;
  }

  .scent-finder-app .coral-arrow {
    position: absolute;
    top: 50%;
    right: 6px;
    width: 44px !important;
    height: 44px !important;
    min-width: 44px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 10px;
    transform: translateY(-50%);
    background: var(--sf-coral) !important;
    color: #fff !important;
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 8px 18px rgba(229, 107, 93, 0.28);
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .scent-finder-app .coral-arrow:hover {
    filter: brightness(1.04);
    transform: translateY(-50%) scale(1.06);
  }

  .scent-finder-app .coral-arrow:disabled,
  .scent-finder-app .ask-button:disabled,
  .scent-finder-app .chat-chip:disabled,
  .scent-finder-app .landing-option:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
    filter: none;
  }

  .scent-finder-app .email-inner {
    width: 100%;
    max-width: 520px;
    padding: 42px 40px 36px;
  }

  .scent-finder-app .email-title {
    font-size: clamp(28px, 4vw, 36px);
    line-height: 1.15;
  }

  .scent-finder-app .email-title strong {
    display: block;
  }

  .scent-finder-app .field-error {
    margin: 12px 6px 0;
    color: #c74435;
    font-size: 12px;
    font-weight: 500;
  }

  .scent-finder-app .field-error[hidden] {
    display: none !important;
  }

  .scent-finder-app .email-consent {
    margin: 14px 6px 0;
    color: rgba(27, 23, 20, 0.42);
    font-size: 11px;
    line-height: 1.55;
  }

  .scent-finder-app .email-consent a {
    color: var(--sf-coral);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .scent-finder-app .email-consent a:hover {
    color: var(--sf-coral-dark);
  }

  .scent-finder-app .chat-step {
    align-items: stretch;
    padding: 24px 28px 80px;
  }

  .scent-finder-app .chat-layout {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(420px, 1.2fr);
    gap: 28px;
    align-items: stretch;
    min-height: calc(100svh - var(--header-offset) - 140px);
  }

  .scent-finder-app .chat-intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 36px 32px;
  }

  .scent-finder-app .chat-title {
    max-width: 500px;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.1;
  }

  .scent-finder-app .chat-description {
    max-width: 460px;
    margin-bottom: 22px;
    font-size: 15px;
  }

  .scent-finder-app .quota-pills {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    color: rgba(27, 23, 20, 0.55);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .scent-finder-app .quota-dots {
    display: flex;
    gap: 5px;
  }

  .scent-finder-app .quota-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .scent-finder-app .quota-dots span.used {
    background: var(--sf-coral);
    box-shadow: none;
    transform: scale(1.08);
  }

  .scent-finder-app .chat-panel {
    width: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 22px;
  }

  .scent-finder-app .chat-thread {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: min(52vh, 480px);
    overflow-y: auto;
    padding: 4px 4px 8px 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(229, 107, 93, 0.45) transparent;
  }

  .scent-finder-app .chat-row {
    display: flex;
    width: 100%;
    animation: sfMsgIn 0.4s ease both;
  }

  .scent-finder-app .chat-row.user {
    justify-content: flex-end;
  }

  @keyframes sfMsgIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .scent-finder-app .user-bubble {
    max-width: min(78%, 320px);
    padding: 12px 18px;
    border-radius: 20px 20px 6px 20px;
    background: #fff4ed;
    color: var(--sf-ink);
    font-size: 13px;
    line-height: 1.45;
    word-break: break-word;
  }

  .scent-finder-app .bot-bubble {
    width: 100%;
    padding: 18px 20px;
    border-radius: 6px 20px 20px 20px;
    background: rgba(255, 255, 255, 0.84);
    box-shadow: 0 10px 28px rgba(40, 28, 20, 0.05);
    color: var(--sf-ink);
    font-size: 13px;
    line-height: 1.65;
  }

  .scent-finder-app .bot-bubble strong {
    font-weight: 700;
  }

  .scent-finder-app .limit-card {
    width: 100%;
    padding: 20px 22px;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 248, 246, 0.96), rgba(255, 236, 230, 0.92));
    border: 1px solid rgba(229, 107, 93, 0.28);
    color: #7a332b;
    font-size: 13px;
    line-height: 1.6;
  }

  .scent-finder-app .limit-card strong {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
  }

  .scent-finder-app .product-card {
    width: 100%;
    display: grid;
    grid-template-columns: 124px 1fr;
    gap: 16px;
    padding: 14px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--sf-line);
    animation: scentFinderProductFadeIn 0.5s ease both;
  }

  @keyframes scentFinderProductFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .scent-finder-app .product-image-wrap {
    width: 124px;
    height: 124px;
    overflow: hidden;
    border-radius: 16px;
    background: linear-gradient(180deg, #f6efe6, #eadfd3);
  }

  .scent-finder-app .product-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .scent-finder-app .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .scent-finder-app .product-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .scent-finder-app .product-label {
    margin-bottom: 5px;
    color: var(--sf-coral);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .scent-finder-app .product-title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
  }

  .scent-finder-app .product-description {
    margin: 0 0 10px;
    color: var(--sf-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .scent-finder-app .product-price {
    margin-bottom: 12px;
    font-size: 13px;
    font-weight: 600;
  }

  .scent-finder-app .product-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: 9px 16px;
    border-radius: 999px;
    background: linear-gradient(135deg, #1b1714, #3a322c);
    color: #fff !important;
    text-decoration: none;
    font-size: 11px;
    font-weight: 500;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .scent-finder-app .product-link:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .scent-finder-app .loading-state {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--sf-muted);
    font-size: 12px;
    font-style: italic;
  }

  .scent-finder-app .loading-dots {
    display: inline-flex;
    gap: 3px;
  }

  .scent-finder-app .loading-dots span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sf-coral);
    animation: scentFinderLoadingDot 1s infinite ease-in-out;
  }

  .scent-finder-app .loading-dots span:nth-child(2) { animation-delay: .15s; }
  .scent-finder-app .loading-dots span:nth-child(3) { animation-delay: .3s; }

  @keyframes scentFinderLoadingDot {
    0%, 60%, 100% { opacity: .3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
  }

  .scent-finder-app .chat-controls {
    width: 100%;
    margin-top: 16px;
    padding-top: 14px;
