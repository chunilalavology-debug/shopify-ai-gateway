    <section class="finder-step chat-step" id="step-3-{{ section.id }}">
      <div class="chat-layout">
        <div class="sf-card chat-intro">
          <div class="ai-icon" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 5C20.8 13.7 26.3 19.2 35 20C26.3 20.8 20.8 26.3 20 35C19.2 26.3 13.7 20.8 5 20C13.7 19.2 19.2 13.7 20 5Z" stroke="#E56B5D" stroke-width="1.8"/>
            </svg>
          </div>
          <p class="sf-kicker">Step 3 of 3</p>
          <h2 class="chat-title">Let's find your <strong>perfect fragrance.</strong></h2>
          <p class="chat-description">
            Tell me about the mood, occasion, ingredients, or fragrances you love and I'll help you find something from our collection.
          </p>
          <div class="quota-pills" aria-live="polite">
            <div class="quota-dots" id="quota-dots-{{ section.id }}"></div>
            <span id="quota-label-{{ section.id }}">5 searches left</span>
          </div>
        </div>

        <div class="sf-card chat-panel">
          <div class="chat-thread" id="chat-thread-{{ section.id }}" aria-live="polite"></div>

          <div class="chat-controls">
            <div class="chat-quick-row">
              <button type="button" class="chat-chip restart" id="restart-button-{{ section.id }}">Restart</button>
              <button type="button" class="chat-chip" data-chat-query="Give me more options">More options</button>
              <button type="button" class="chat-chip" data-chat-query="Show me unisex options">Unisex</button>
              <button type="button" class="chat-chip" data-chat-query="Show me CN1 Originals">CN1 Originals</button>
              <button type="button" class="chat-chip" data-chat-query="I need a fragrance for a party">For a party</button>
              <button type="button" class="chat-chip" data-chat-query="A warm vanilla scent">Vanilla</button>
