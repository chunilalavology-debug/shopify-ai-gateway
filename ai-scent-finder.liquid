   * ---------------------------------------------------------
   * STEP 1
   * ---------------------------------------------------------
   */

  function handleLandingSubmit() {
    const value =
      landingQuery.value.trim();

    if (!value) {
      landingQuery.focus();
      return;
    }

    selectedQuery = value;

    updateMoodBackground(
      selectedQuery
    );

    showStep(2);
  }

  /*
   * ---------------------------------------------------------
   * STEP 2
   * ---------------------------------------------------------
   */

  function handleEmailSubmit() {
    const email =
      customerEmailInput.value.trim();

    if (
      !isValidEmail(email)
    ) {
      emailError.hidden = false;

      customerEmailInput.focus();

      return;
    }

    emailError.hidden = true;

    customerEmail = email;

    submitEmailToShopify(
      customerEmail
    );

    chatThread.innerHTML = "";

    conversation = [];

    previousHandles = [];

    lastGuestQuery = selectedQuery;

    updateGuestPanel(
      selectedQuery,
      0
    );

    appendWelcome(
      selectedQuery
    );

    renderQuota();

    showStep(3);

    askAssistant(
      selectedQuery
    );
  }

  /*
   * ---------------------------------------------------------
   * MAIN AI REQUEST
   * ---------------------------------------------------------
   */

  async function askAssistant(query) {
    const text =
      String(query || "").trim();

    if (
      !text ||
      isBusy
    ) {
      return;
    }

    if (
      countWords(text) >
      MAX_INPUT_WORDS
    ) {
      appendBotMessage(
        "Please keep your message under 800 words."
      );

      return;
    }

    isBusy = true;

    setChatEnabled(false);

    lastGuestQuery = text;

    updateGuestPanel(text);

    appendUserMessage(text);

    showTyping();

    updateMoodBackground(text);

    chatQuery.value = "";

    try {
      const response =
        await fetch(
          AI_ENDPOINT,
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              Accept:
                "application/json"
            },

            body:
              JSON.stringify({
                text: text,

                email:
                  customerEmail,

                session_id:
                  getSessionId(),

                history:
                  conversation
                    .slice(0, -1)
                    .slice(
                      -HISTORY_LIMIT
                    ),

                previous_handles:
                  previousHandles,

                /*
                 * Backend can use these values.
                 * Frontend still enforces the limit.
                 */
                max_reply_chars: 100,

                max_output_chars: 100
              })
          }
        );

      let data = {};

      try {
        data =
          await response.json();
      } catch (err) {
        data = {};
      }

      hideTyping();

      /*
       * SERVER RATE LIMIT
       */
      if (
        response.status === 429 ||
        data.error ===
          "rate_limit_exceeded"
      ) {
        appendBotMessage(
          data.message ||
            "Nothing matched that. If you'd like, I can suggest something."
        );

        return;
      }

      /*
       * MESSAGE TOO LONG
       */
      if (
        data.error ===
        "message_too_long"
      ) {
        appendBotMessage(
          data.message ||
            "Please keep your message under 800 words."
        );

        return;
      }

      /*
       * GENERAL API ERROR
       */
      if (!response.ok) {
        appendBotMessage(
          data.message ||
            "Nothing matched that. If you'd like, I can suggest something."
        );

        return;
      }

      markAskUsed();

      if (
        typeof data.remaining ===
          "number"
      ) {
        syncRemainingFromServer(
          data.remaining
        );
      }

      updateMoodBackground(
        text,
        data.bg_color
      );

      /*
       * -----------------------------------------------------
       * AI RESPONSE
       * -----------------------------------------------------
       *
       * appendBotMessage() applies the absolute 100
       * character frontend limit.
       */
      const reply =
        data.reply ||
        data.message ||
        "Here are a few scents that match.";

      appendBotMessage(
        reply
      );

      /*
       * -----------------------------------------------------
       * PRODUCT CARDS
       * -----------------------------------------------------
       *
       * NO intent check.
       *
       * Product cards are attempted for EVERY AI response.
       */
      const products =
        await discoverProducts(
          data,
          text
        );

      /*
       * Save handles for future queries.
       */
      products.forEach(
        function (product) {
          const handle =
            cleanHandle(
              product.handle
            );

          if (
            handle &&
            previousHandles.indexOf(
              handle
            ) === -1
          ) {
            previousHandles.push(
              handle
            );
          }
        }
      );

      /*
       * Always render cards whenever Shopify returned
       * products.
       */
      if (
        products.length
      ) {
        renderProductCards(
          await withOriginalFlags(
            products
          )
        );
      } else {
        updateGuestPanel(
          text,
          0
        );

        if (data.no_match === true) {
          previousHandles = [];
        }
      }
    } catch (error) {
      console.error(
        "AI Scent Finder API error:",
        error
      );

      hideTyping();

      appendBotMessage(
        "Nothing matched that. If you'd like, I can suggest something."
      );
    } finally {
      isBusy = false;

      renderQuota();

      setChatEnabled(true);
    }
  }

