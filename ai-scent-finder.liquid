<div
  class="scent-finder-app"
  id="scent-finder-app-{{ section.id }}"
  data-mood="default"
>
  <div class="sf-atmosphere" aria-hidden="true">
    <span class="sf-mesh"></span>
    <span class="sf-orb sf-orb-a"></span>
    <span class="sf-orb sf-orb-b"></span>
    <span class="sf-orb sf-orb-c"></span>
    <span class="sf-orb sf-orb-d"></span>
  </div>

  <div class="scent-finder-content">

    <!-- STEP 1 -->
    <section
      class="finder-step landing-step active"
      id="step-1-{{ section.id }}"
    >
      <div class="landing-inner">

        <div class="scent-mist" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <p class="sf-kicker">
          Personal scent concierge
        </p>

        <h1 class="landing-title">
          {{ section.settings.step1_heading_prefix | default: 'Try our ' }}
          <strong>
            {{ section.settings.step1_heading_bold | default: 'AI Scent Finder' }}
          </strong>
        </h1>

        <p class="landing-question">
          <span>
            {{ section.settings.step1_question_prefix | default: 'What are ' }}
            <strong>
              {{ section.settings.step1_question_bold | default: 'you looking for today?' }}
            </strong>
          </span>

          <span
            class="info-dot"
            title="Tell us about the mood, occasion, ingredient, or fragrance you're looking for."
          >
            i
          </span>
        </p>

        {% liquid
