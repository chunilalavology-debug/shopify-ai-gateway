  (function setupEmojiPicker() {
    const toggle = document.getElementById(
      "emoji-toggle-" + sectionId
    );
    const panel = document.getElementById(
      "emoji-panel-" + sectionId
    );

    if (!toggle || !panel) {
      return;
    }

    const emojis = (
      "😀 😃 😄 😁 😆 😅 🤣 😂 🙂 😉 😊 😇 🥰 😍 🤩 😘 😗 😚 😙 😋 😛 😜 🤪 😝 🤑 🤗 🤭 🤫 🤔 🤐 🤨 😐 😑 😶 😏 😒 🙄 😬 😌 😔 😪 🤤 😴 😷 🤒 🤕 🤢 🤮 🥵 🥶 🥴 😵 🤯 🤠 🥳 😎 🤓 🧐 😕 😟 🙁 😮 😯 😲 😳 🥺 😦 😧 😨 😰 😥 😢 😭 😱 😖 😣 😞 😓 😩 😫 🥱 😤 😡 😠 🤬 😈 👿 💀 ☠️ 💩 🤡 👹 👺 👻 👽 🤖 " +
      "👋 🤚 🖐️ ✋ 🖖 👌 🤌 🤏 ✌️ 🤞 🤟 🤘 🤙 👈 👉 👆 👇 ☝️ 👍 👎 ✊ 👊 🤛 🤜 👏 🙌 👐 🤲 🤝 🙏 ✍️ 💅 🤳 💪 🦾 🦵 🦶 👂 👃 🧠 👀 👁️ 👅 👄 💋 💘 💝 💖 💗 💓 💞 💕 💟 ❣️ 💔 ❤️ 🧡 💛 💚 💙 💜 🖤 🤍 🤎 💯 💢 💥 💫 💦 💨 🕳️ 💬 🗨️ 🗯️ 💭 " +
      "🐶 🐱 🐭 🐹 🐰 🦊 🐻 🐼 🐨 🐯 🦁 🐮 🐷 🐸 🐵 🙈 🙉 🙊 🐒 🐔 🐧 🐦 🐤 🦆 🦅 🦉 🦇 🐺 🐗 🐴 🦄 🐝 🐛 🦋 🐌 🐞 🐜 🦟 🌸 💐 🌹 🥀 🌺 🌻 🌼 🌷 🌱 🌲 🌳 🌴 🌵 🌾 🌿 ☘️ 🍀 🍁 🍂 🍃 " +
      "🍇 🍈 🍉 🍊 🍋 🍌 🍍 🥭 🍎 🍏 🍐 🍑 🍒 🍓 🥝 🍅 🥥 🥑 🍆 🥔 🥕 🌽 🌶️ 🥒 🥬 🥦 🧄 🧅 🍄 🥜 🍞 🥐 🥖 🥨 🧀 🥚 🍳 🥞 🧇 🥓 🥩 🍗 🍖 🌭 🍔 🍟 🍕 🥪 🌮 🌯 🥙 🧆 🥗 🍝 🍜 🍲 🍛 🍣 🍱 🥟 🍤 🍙 🍚 🍘 🍥 🥠 🍢 🍡 🍧 🍨 🍦 🥧 🍰 🎂 🍮 🍭 🍬 🍫 🍿 🍩 🍪 🥛 ☕ 🍵 🧃 🥤 🧋 🍶 🍺 🍻 🥂 🍷 🥃 🍸 🍹 🍾 " +
      "⚽ 🏀 🏈 ⚾ 🎾 🏐 🏉 🎱 🏓 🏸 🥅 🏒 🏑 🏏 ⛳ 🏹 🎣 🥊 🥋 🎽 ⛸️ 🥌 🎿 ⛷️ 🏂 🏋️ 🤸 ⛹️ 🤺 🤾 🏌️ 🏇 🧘 🏄 🏊 🤽 🚣 🧗 🚴 🚵 🎪 🎭 🎨 🎬 🎤 🎧 🎼 🎹 🥁 🎷 🎺 🎸 🎻 🎲 ♟️ 🎯 🎳 🎮 🎰 " +
      "🚗 🚕 🚙 🚌 🚎 🏎️ 🚓 🚑 🚒 🚐 🚚 🚛 🚜 🛵 🏍️ 🚲 🛴 ✈️ 🚀 🛸 🚁 ⛵ 🚤 🛳️ ⛴️ 🚢 ⚓ 🏠 🏡 🏢 🏣 🏤 🏥 🏦 🏨 🏩 🏪 🏫 🏬 🏭 🏰 🗼 🗽 ⛪ 🕌 🕍 ⛩️ 🕋 ⛲ ⛺ 🌁 🌃 🏙️ 🌄 🌅 🌆 🌇 🌉 🎠 🎡 🎢 " +
      "⌚ 📱 💻 ⌨️ 🖥️ 🖨️ 🖱️ 📷 📸 📹 🎥 📞 ☎️ 📺 📻 🎙️ ⏰ ⌛ ⏳ 💡 🔦 🕯️ 💰 💵 💴 💶 💷 💳 💎 ⚖️ 🔧 🔨 ⚒️ 🛠️ ⛏️ 🔩 ⚙️ 🔫 💣 🔪 🗡️ 🛡️ 🔮 🧿 🧸 🎁 🎈 🎉 🎊 🎀 🏆 🥇 🥈 🥉 🏅 🎖️ 🏵️ " +
      "✨ ⭐ 🌟 💫 ⚡ 🔥 💥 ☀️ 🌤️ ⛅ 🌥️ ☁️ 🌦️ 🌧️ ⛈️ 🌩️ 🌨️ ❄️ ☃️ ⛄ 🌬️ 💨 💧 💦 ☔ ☂️ 🌊 🌫️ 🌈 🌙 🌛 🌜 🌚 🌝 🌞 ✅ ❌ ⭕ ❓ ❗ ‼️ ⁉️ 💯 🔴 🟠 🟡 🟢 🔵 🟣 ⚫ ⚪ 🟤 🔺 🔻 🔸 🔹 🔶 🔷"
    ).split(/\s+/);

    emojis.forEach(function (emoji) {
      const button = document.createElement("button");

      button.type = "button";
      button.textContent = emoji;
      button.setAttribute("data-emoji", emoji);
      button.setAttribute("aria-label", emoji);
      panel.appendChild(button);
    });

    function setOpen(open) {
      panel.hidden = !open;
      toggle.setAttribute(
        "aria-expanded",
        open ? "true" : "false"
      );
    }

    toggle.addEventListener(
      "click",
      function (event) {
        event.preventDefault();
        event.stopPropagation();
        setOpen(panel.hidden);
      }
    );

    panel.addEventListener(
      "click",
      function (event) {
        const button = event.target.closest(
          "[data-emoji]"
        );

        if (!button) {
          return;
        }

        event.preventDefault();
        event.stopPropagation();

        const emoji = button.getAttribute(
          "data-emoji"
        );
        const start = chatQuery.selectionStart;
        const end = chatQuery.selectionEnd;
        const value = chatQuery.value;

        chatQuery.value =
          value.slice(0, start) +
          emoji +
          value.slice(end);

        const caret = start + emoji.length;

        chatQuery.focus();
        chatQuery.setSelectionRange(
          caret,
          caret
        );
      }
    );

    document.addEventListener(
      "click",
      function (event) {
        if (
          panel.hidden ||
          panel.contains(event.target) ||
          toggle.contains(event.target)
        ) {
          return;
        }

        setOpen(false);
      }
    );
  })();

  app
    .querySelectorAll(
      ".chat-chip[data-chat-query]"
    )
    .forEach(function (button) {
      button.addEventListener(
        "click",
        function () {
          const query =
            this.getAttribute(
              "data-chat-query"
            );

          if (query) {
            askAssistant(query);
          }
        }
      );
    });

  /*
   * ---------------------------------------------------------
   * RESTART
   * ---------------------------------------------------------
   */

  restartButton.addEventListener(
    "click",
    function () {
      selectedQuery = "";

      customerEmail = "";

      isBusy = false;

      conversation = [];

      previousHandles = [];

      landingQuery.value = "";

      app
        .querySelectorAll(
          ".landing-option"
        )
        .forEach(function (item) {
          item.classList.remove(
            "is-active"
          );
        });

      customerEmailInput.value = "";

      chatQuery.value = "";

      chatThread.innerHTML = "";

      emailError.hidden = true;

      app.removeAttribute("style");

      app.setAttribute(
        "data-mood",
        "default"
      );

      renderQuota();

      setChatEnabled(true);

      showStep(1);
    }
  );

  /*
   * ---------------------------------------------------------
   * INITIALIZE
   * ---------------------------------------------------------
   */

  renderQuota();

  setChatEnabled(true);

  fetch(AI_ENDPOINT, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Accept: "application/json"
    },
    body: JSON.stringify({
      warmup: true
    })
  }).catch(function () {});

  showStep(1);

})();
</script>

