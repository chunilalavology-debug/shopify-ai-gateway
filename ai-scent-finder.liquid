    <section class="finder-step active" id="step-1-{{ section.id }}">
      <div class="sf-card landing-inner">
        <div class="ai-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 5C20.8 13.7 26.3 19.2 35 20C26.3 20.8 20.8 26.3 20 35C19.2 26.3 13.7 20.8 5 20C13.7 19.2 19.2 13.7 20 5Z" stroke="#E56B5D" stroke-width="1.8"/>
          </svg>
        </div>
        <p class="sf-kicker">Step 1 of 3</p>
        <h1 class="landing-title">{{ section.settings.step1_heading_prefix | default: 'Try our ' }}<strong>{{ section.settings.step1_heading_bold | default: 'AI Scent Finder' }}</strong></h1>

        <p class="landing-question">
          <span>{{ section.settings.step1_question_prefix | default: 'What are ' }}<strong>{{ section.settings.step1_question_bold | default: 'you looking for today?' }}</strong></span>
